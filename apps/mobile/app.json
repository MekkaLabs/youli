{
  "expo": {
    "name": "Youli",
    "slug": "youli",
    "scheme": "youli",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#030712",

    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "bundleIdentifier": "com.youli.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Youli usa a câmera para adicionar fotos ao seu Vision Board.",
        "NSPhotoLibraryUsageDescription": "Youli acessa suas fotos para personalizar seu perfil e Vision Board.",
        "NSMicrophoneUsageDescription": "Youli usa o microfone para comandos de voz ao Copilot.",
        "NSMotionUsageDescription": "Youli monitora atividade física para o Life Health Score.",
        "NSHealthShareUsageDescription": "Youli lê dados de saúde para calcular seu Score de Fitness.",
        "NSHealthUpdateUsageDescription": "Youli atualiza metas de saúde baseadas no seu progresso.",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:youli.app"]
    },

    "android": {
      "package": "com.youli.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030712"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "youli.app" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },

    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7C3AED",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ]
    ],

    "extra": {
      "eas": { "projectId": "youli-app-project-id" }
    },

    "owner": "youli",
    "experiments": { "typedRoutes": true },

    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/youli-app-project-id"
    }
  }
}
