# ═══════════════════════════════════════════════════════════════════════════
# YOULI API — Variáveis de Ambiente
# Copie para .env.local e preencha com suas credenciais reais
# ═══════════════════════════════════════════════════════════════════════════

# ─── API URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3002

# ─── Segurança / CORS ────────────────────────────────────────────────────────
# Origens permitidas para CORS — CSV. Em dev libera localhost automaticamente.
# Em prod, vazio = NEGA. Exemplo: https://app.youli.app,https://admin.youli.app
CORS_ALLOWED_ORIGINS=

# Token para rotas internas/admin (header X-Youli-Admin-Token).
# Gere com: openssl rand -hex 32
YOULI_ADMIN_TOKEN=

# ─── Open Banking (Pluggy/Belvo) ─────────────────────────────────────────────
OPEN_FINANCE_PROVIDER=mock
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# 1. Acesse: https://app.supabase.com → New Project
# 2. Copie a URL do projeto e a service_role key
# 3. No SQL Editor, execute: apps/api/supabase/migrations/001_youli_schema.sql
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...sua_service_role_key_aqui

# ID do perfil padrão (deve existir na tabela profiles)
YOULI_PROFILE_ID=user-1

# Liga a persistência no Supabase. Default (vazio/false) = JSON local por usuário.
# Só ative quando o schema estiver aplicado e acessível.
YOULI_USE_SUPABASE=false

# Segredo para assinar tokens de sessão (HMAC). OBRIGATÓRIO em produção.
# Gere um valor forte: `openssl rand -hex 32`. Em dev, há fallback inseguro com aviso.
YOULI_SESSION_SECRET=

# ─── Anthropic Claude API ────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Orquestrador ────────────────────────────────────────────────────────────
ORCHESTRATOR_NAME=Youli
ORCHESTRATOR_EMOJI=✦

# ─── Strava Integration ──────────────────────────────────────────────────────
# https://www.strava.com/settings/api → Criar app
# Callback URL dev:  http://localhost:3002/api/integrations/strava/callback
# Callback URL prod: https://api.youli.app/api/integrations/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ─── Google Calendar Integration ─────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth client
# Tipo: Web application. Authorized redirect URI (dev):
#   http://localhost:3002/api/integrations/google/callback
# Habilite a "Google Calendar API" no projeto. Escopo: calendar.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Zepp Health Integration ─────────────────────────────────────────────────
# https://developer.zepp.com → Registrar app
# Callback URL dev:  http://localhost:3002/api/integrations/zepp/callback
# Callback URL prod: https://api.youli.app/api/integrations/zepp/callback
ZEPP_CLIENT_ID=
ZEPP_CLIENT_SECRET=

# ─── AIOS Core (multi-agent framework) ──────────────────────────────────────
# NÃO commitar valores reais. Use ./scripts/setup-aios.mjs para autodetectar.
AIOS_CORE_PATH=
SQUADS_PATH=
