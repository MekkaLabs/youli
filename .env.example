# ═══════════════════════════════════════════════════════════════════════════
# YOULI — Variáveis de Ambiente (raiz do monorepo)
# Copie para .env.local e preencha. Sempre que adicionar uma variável NOVA
# no app, atualize também este arquivo.
# ═══════════════════════════════════════════════════════════════════════════

# ───────── REQUIRED em produção ─────────

# Base URL pública da API consumida pelo mobile.
NEXT_PUBLIC_API_URL=http://localhost:3002

# Origens permitidas para CORS — CSV. Em dev (NODE_ENV != production)
# o middleware já libera localhost:3000/3002/8081/19006 automaticamente.
# Em produção, vazio = NEGA tudo. Defina explicitamente o(s) domínio(s).
# Exemplo: CORS_ALLOWED_ORIGINS=https://app.youli.app,https://admin.youli.app
CORS_ALLOWED_ORIGINS=

# Token para rotas internas/administrativas (header X-Youli-Admin-Token).
# Gere com: openssl rand -hex 32
YOULI_ADMIN_TOKEN=

# Anthropic Claude (LLM principal).
ANTHROPIC_API_KEY=

# ───────── OPCIONAIS ─────────

# OpenAI (caso queira fallback / embeddings reais).
OPENAI_API_KEY=

# Supabase (persistência real — sem isso, fallback em JSON local).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (filas, opcional).
REDIS_URL=

# ID do perfil padrão (necessário se Supabase configurado).
YOULI_PROFILE_ID=user-1

# ───────── Open Banking ─────────
# mock | pluggy | belvo — se 'pluggy' ou 'belvo' sem credenciais válidas,
# o adapter cai pro Mock e loga warning.
OPEN_FINANCE_PROVIDER=mock
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=

# ───────── Strava / Zepp (fitness, OAuth) ─────────
# Callback dev:  http://localhost:3002/api/integrations/<provider>/callback
# Callback prod: https://api.youli.app/api/integrations/<provider>/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
ZEPP_CLIENT_ID=
ZEPP_CLIENT_SECRET=

# ───────── AIOS Core ─────────
# Caminhos LOCAIS — NÃO commitar valores reais. Use ./scripts/setup-aios.mjs
# que detecta automaticamente em paths comuns (~/Documents/aios-core, etc.).
AIOS_CORE_PATH=
SQUADS_PATH=

# ───────── Branding ─────────
ORCHESTRATOR_NAME=Youli
ORCHESTRATOR_EMOJI=✦
